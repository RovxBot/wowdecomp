{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WOWDECOMP_BUILD_CLIENT": "OFF",
        "WOWDECOMP_BUILD_PORTABLE_CORE": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-core",
      "inherits": "core-base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "macos-arm64-core",
      "inherits": "core-base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "windows-core",
      "inherits": "core-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-core-asan",
      "inherits": "linux-core",
      "cacheVariables": {
        "WOWDECOMP_CORE_SANITIZERS": "ON"
      }
    },
    {
      "name": "linux-files",
      "inherits": "linux-core",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_FILES": "ON"
      }
    },
    {
      "name": "linux-files-asan",
      "inherits": "linux-files",
      "cacheVariables": {
        "WOWDECOMP_CORE_SANITIZERS": "ON"
      }
    },
    {
      "name": "macos-arm64-files",
      "inherits": "macos-arm64-core",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_FILES": "ON"
      }
    },
    {
      "name": "windows-files",
      "inherits": "windows-core",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_FILES": "ON"
      }
    },
    {
      "name": "linux-assets",
      "inherits": "linux-files",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_ASSETS": "ON"
      }
    },
    {
      "name": "linux-assets-asan",
      "inherits": "linux-files-asan",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_ASSETS": "ON"
      }
    },
    {
      "name": "macos-arm64-assets",
      "inherits": "macos-arm64-files",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_ASSETS": "ON"
      }
    },
    {
      "name": "windows-assets",
      "inherits": "windows-files",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_ASSETS": "ON"
      }
    }
  ]
}
