{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "WOWDECOMP_BUILD_CLIENT": "OFF",
        "WOWDECOMP_BUILD_PORTABLE_CORE": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-core",
      "inherits": "core-base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "macos-arm64-core",
      "inherits": "core-base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "windows-core",
      "inherits": "core-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-core-asan",
      "inherits": "linux-core",
      "cacheVariables": {
        "WOWDECOMP_CORE_SANITIZERS": "ON"
      }
    },
    {
      "name": "linux-files",
      "inherits": "linux-core",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_FILES": "ON"
      }
    },
    {
      "name": "linux-files-asan",
      "inherits": "linux-files",
      "cacheVariables": {
        "WOWDECOMP_CORE_SANITIZERS": "ON"
      }
    },
    {
      "name": "macos-arm64-files",
      "inherits": "macos-arm64-core",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_FILES": "ON"
      }
    },
    {
      "name": "windows-files",
      "inherits": "windows-core",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_FILES": "ON"
      }
    },
    {
      "name": "linux-assets",
      "inherits": "linux-files",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_ASSETS": "ON"
      }
    },
    {
      "name": "linux-assets-asan",
      "inherits": "linux-files-asan",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_ASSETS": "ON"
      }
    },
    {
      "name": "macos-arm64-assets",
      "inherits": "macos-arm64-files",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_ASSETS": "ON"
      }
    },
    {
      "name": "windows-assets",
      "inherits": "windows-files",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_ASSETS": "ON"
      }
    },
    {
      "name": "linux-async",
      "inherits": "linux-assets",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_ASYNC": "ON"
      }
    },
    {
      "name": "linux-async-asan",
      "inherits": "linux-assets-asan",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_ASYNC": "ON"
      }
    },
    {
      "name": "macos-arm64-async",
      "inherits": "macos-arm64-assets",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_ASYNC": "ON"
      }
    },
    {
      "name": "windows-async",
      "inherits": "windows-assets",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_ASYNC": "ON"
      }
    },
    {
      "name": "linux-window",
      "inherits": "linux-async",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_WINDOW": "ON"
      }
    },
    {
      "name": "linux-window-asan",
      "inherits": "linux-async-asan",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_WINDOW": "ON"
      }
    },
    {
      "name": "macos-arm64-window",
      "inherits": "macos-arm64-async",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_WINDOW": "ON"
      }
    },
    {
      "name": "windows-window",
      "inherits": "windows-async",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_WINDOW": "ON"
      }
    },
    {
      "name": "linux-window-dynamic-asan",
      "inherits": "linux-window-asan",
      "cacheVariables": {
        "WOWDECOMP_SDL_LINK_DISPLAY_DEPS": "OFF"
      }
    },
    {
      "name": "linux-gl",
      "inherits": "linux-window",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_GL": "ON",
        "WOWDECOMP_BUILD_NATIVE_LUA": "ON",
        "WOWDECOMP_BUILD_NATIVE_FRAMESCRIPT": "ON",
        "WOWDECOMP_BUILD_NATIVE_XML": "ON",
        "WOWDECOMP_BUILD_NATIVE_LAYOUT": "ON",
        "WOWDECOMP_BUILD_NATIVE_FRAME_FONTS": "ON"
      }
    },
    {
      "name": "linux-gl-asan",
      "inherits": "linux-gl",
      "cacheVariables": {
        "WOWDECOMP_CORE_SANITIZERS": "ON"
      }
    },
    {
      "name": "linux-packets",
      "inherits": "linux-core",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_PACKETS": "ON"
      }
    },
    {
      "name": "linux-packets-asan",
      "inherits": "linux-core-asan",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_PACKETS": "ON"
      }
    },
    {
      "name": "macos-arm64-packets",
      "inherits": "macos-arm64-core",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_PACKETS": "ON"
      }
    },
    {
      "name": "windows-packets",
      "inherits": "windows-core",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_PACKETS": "ON"
      }
    },
    {
      "name": "linux-lua",
      "inherits": "linux-core",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_LUA": "ON"
      }
    },
    {
      "name": "linux-lua-asan",
      "inherits": "linux-core-asan",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_LUA": "ON"
      }
    },
    {
      "name": "macos-arm64-lua",
      "inherits": "macos-arm64-core",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_LUA": "ON"
      }
    },
    {
      "name": "windows-lua",
      "inherits": "windows-core",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_LUA": "ON"
      }
    },
    {
      "name": "linux-framescript",
      "inherits": "linux-async",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_LUA": "ON",
        "WOWDECOMP_BUILD_NATIVE_FRAMESCRIPT": "ON"
      }
    },
    {
      "name": "linux-framescript-asan",
      "inherits": "linux-async-asan",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_LUA": "ON",
        "WOWDECOMP_BUILD_NATIVE_FRAMESCRIPT": "ON"
      }
    },
    {
      "name": "macos-arm64-framescript",
      "inherits": "macos-arm64-async",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_LUA": "ON",
        "WOWDECOMP_BUILD_NATIVE_FRAMESCRIPT": "ON"
      }
    },
    {
      "name": "windows-framescript",
      "inherits": "windows-async",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_LUA": "ON",
        "WOWDECOMP_BUILD_NATIVE_FRAMESCRIPT": "ON"
      }
    },
    {
      "name": "linux-xml",
      "inherits": "linux-framescript",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_XML": "ON"
      }
    },
    {
      "name": "linux-xml-asan",
      "inherits": "linux-framescript-asan",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_XML": "ON"
      }
    },
    {
      "name": "macos-arm64-xml",
      "inherits": "macos-arm64-framescript",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_XML": "ON"
      }
    },
    {
      "name": "windows-xml",
      "inherits": "windows-framescript",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_XML": "ON"
      }
    },
    {
      "name": "linux-layout",
      "inherits": "linux-xml",
      "binaryDir": "${sourceDir}/build/linux-layout",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_LAYOUT": "ON"
      }
    },
    {
      "name": "linux-layout-asan",
      "inherits": "linux-xml-asan",
      "binaryDir": "${sourceDir}/build/linux-layout-asan",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_LAYOUT": "ON"
      }
    },
    {
      "name": "macos-arm64-layout",
      "inherits": "macos-arm64-xml",
      "binaryDir": "${sourceDir}/build/macos-arm64-layout",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_LAYOUT": "ON"
      }
    },
    {
      "name": "windows-layout",
      "inherits": "windows-xml",
      "binaryDir": "${sourceDir}/build/windows-layout",
      "cacheVariables": {
        "WOWDECOMP_BUILD_NATIVE_LAYOUT": "ON"
      }
    }
  ]
}
