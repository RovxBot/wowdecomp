# Walk common directories and only the explicitly selected platform directory.
# Never enter the other Windows tree (even when its files have width guards).
function(wowdecomp_collect_sources result)
    wowdecomp_collect_directory(sources "${CMAKE_CURRENT_SOURCE_DIR}")
    set(${result} "${sources}" PARENT_SCOPE)
endfunction()

function(wowdecomp_collect_directory result directory)
    file(GLOB sources CONFIGURE_DEPENDS "${directory}/*.cpp")
    file(GLOB children LIST_DIRECTORIES true CONFIGURE_DEPENDS "${directory}/*")
    foreach(child IN LISTS children)
        if(IS_DIRECTORY "${child}")
            get_filename_component(name "${child}" NAME)
            if(name MATCHES "^(Win32|Win64|Windows|win32|Linux|Mac|macOS|Posix|Portable)$")
                if(NOT name IN_LIST WOWDECOMP_PLATFORM_SOURCE_DIRS)
                    continue()
                endif()
            endif()
            wowdecomp_collect_directory(nested "${child}")
            list(APPEND sources ${nested})
        endif()
    endforeach()
    set(${result} "${sources}" PARENT_SCOPE)
endfunction()
