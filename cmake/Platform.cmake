# OS, CPU and pointer width are independent target properties.
if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    set(WOWDECOMP_OS WINDOWS)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(WOWDECOMP_OS LINUX)
    set(WOWDECOMP_PLATFORM_SOURCE_DIRS Linux Posix)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(WOWDECOMP_OS MACOS)
    set(WOWDECOMP_PLATFORM_SOURCE_DIRS Mac macOS Posix)
else()
    message(FATAL_ERROR "Unsupported target OS: ${CMAKE_SYSTEM_NAME}")
endif()

if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES architecture_count)
    if(NOT architecture_count EQUAL 1)
        message(FATAL_ERROR "Select one macOS architecture per build directory.")
    endif()
    set(target_cpu "${CMAKE_OSX_ARCHITECTURES}")
elseif(MSVC AND CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
    set(target_cpu "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
else()
    set(target_cpu "${CMAKE_SYSTEM_PROCESSOR}")
endif()
string(TOLOWER "${target_cpu}" target_cpu)
if(target_cpu MATCHES "^(amd64|x86_64|x64)$")
    set(WOWDECOMP_CPU X86_64)
elseif(target_cpu MATCHES "^(arm64|aarch64)$")
    set(WOWDECOMP_CPU ARM64)
elseif(target_cpu MATCHES "^(x86|i[3-6]86)$")
    set(WOWDECOMP_CPU X86)
else()
    message(FATAL_ERROR "Unsupported target CPU: ${target_cpu}")
endif()

if(CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(WOWDECOMP_ARCH_64 1)
    set(WOWDECOMP_POINTER_BITS 64)
elseif(CMAKE_SIZEOF_VOID_P EQUAL 4)
    set(WOWDECOMP_ARCH_32 1)
    set(WOWDECOMP_POINTER_BITS 32)
else()
    message(FATAL_ERROR "Unsupported pointer size: ${CMAKE_SIZEOF_VOID_P}")
endif()
if((WOWDECOMP_CPU STREQUAL "X86" AND NOT WOWDECOMP_POINTER_BITS EQUAL 32)
   OR (NOT WOWDECOMP_CPU STREQUAL "X86" AND NOT WOWDECOMP_POINTER_BITS EQUAL 64))
    message(FATAL_ERROR "CPU and pointer width disagree; select a matching toolchain.")
endif()

# Initial compiler matrix; other compilers must be validated before enabling them.
if(MSVC)
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR MSVC_VERSION LESS 1930)
        message(FATAL_ERROR "Windows currently requires Visual Studio 2022 MSVC.")
    endif()
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS 14)
        message(FATAL_ERROR "Clang 14 or newer is required.")
    endif()
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
    if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS 14)
        message(FATAL_ERROR "Apple Clang 14 or newer is required.")
    endif()
else()
    message(FATAL_ERROR "Use MSVC on Windows or Clang/Apple Clang for the portable core.")
endif()

add_library(wowdecomp_platform INTERFACE)
target_compile_features(wowdecomp_platform INTERFACE cxx_std_17)
target_compile_definitions(wowdecomp_platform INTERFACE
    WOWDECOMP_OS_${WOWDECOMP_OS}=1
    WOWDECOMP_CPU_${WOWDECOMP_CPU}=1
    WOWDECOMP_ARCH_${WOWDECOMP_POINTER_BITS}=1
)
message(STATUS "wowdecomp target: ${WOWDECOMP_OS}/${WOWDECOMP_CPU}/${WOWDECOMP_POINTER_BITS}")
